# Copy this file to configs/local.env and fill local-only credentials.
# Do not commit configs/local.env.

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=deepseek-v4-pro
# rules = deterministic ranking only; llm = external LLM reranks real retrieved candidates.
LIT_AGENT_SELECTION_MODE=llm
UNPAYWALL_EMAIL=your_email@example.com
